# Build output. Everything in here is generated by webpack except the artwork
# below, which is committed because the Blade admin panel references it directly
# and never goes through the bundler.
#
# Note the shape: git will not re-include a file whose parent directory is
# excluded, so "assets" itself must stay un-ignored and only its contents get
# excluded.
assets/*
!assets/svgs/
assets/svgs/*
!assets/svgs/*.svg
!assets/svgs/*.png
